name: "visionlytics_rtdetr_v2"
platform: "onnxruntime_onnx"
max_batch_size: 8
input [
  {
    name: "pixel_values"
    data_type: TYPE_FP32
    dims: [ 3, 640, 640 ]
  }
]
output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [ 300, 80 ]
  },
  {
    name: "pred_boxes"
    data_type: TYPE_FP32
    dims: [ 300, 4 ]
  }
]
dynamic_batching {
  preferred_batch_size: [ 1, 4, 8 ]
  max_queue_delay_microseconds: 2000
}
instance_group [
  {
    count: 1
    kind: KIND_AUTO
  }
]
