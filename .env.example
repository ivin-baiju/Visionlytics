# ==============================================================================
# Visionlytics Environment Configuration Template
# Copy this file to .env or .env.local and populate with your production credentials.
# NEVER commit .env or secrets to git.
# ==============================================================================

# ── Backend Security & Auth ──────────────────────────────────────────────────
# Generate a secure secret using: openssl rand -hex 32
VISIONLYTICS_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
VISIONLYTICS_DEBUG=false

# ── CORS Settings ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI backend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://visionlytics-alpha.vercel.app

# ── Supabase Cloud Database (PostgreSQL) ──────────────────────────────────────
# Find these in your Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Backend service role key (keep secret, never expose on frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── Frontend Next.js Public Keys ─────────────────────────────────────────────
# Exposed to browser for anonymous read queries and authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Fast API Backend URL for Frontend proxy
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ── Email OTP Delivery (Gmail SMTP) ──────────────────────────────────────────
# Create an App Password in Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_EMAIL=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-char-google-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── SMS OTP Delivery (Twilio Optional) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
